# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── Database (PostgreSQL via Prisma) ───────────────────────
DATABASE_URL="postgresql://postgres:190924@localhost:5432/fitnerve_dev?schema=public"

# ── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=fitnerve_access_secret_2026_super_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=fitnerve_refresh_secret_2026_super_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ── Password Reset ──────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30
PASSWORD_RESET_URL_BASE=https://app.fitnerve.com/reset-password

# ── Bcrypt ──────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── CORS ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# ── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ── File Storage ────────────────────────────────────────
# STORAGE_DRIVER = "local" | "s3"
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ── AWS S3 (only used when STORAGE_DRIVER=s3) ──────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=fitnerve-media

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
