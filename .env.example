# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── Database (PostgreSQL via Prisma) ───────────────────────
DATABASE_URL="postgresql://fitnerve:fitnerve@localhost:5432/fitnerve_dev?schema=public"

# ── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Require client email verification before login (default: enabled).
REQUIRE_EMAIL_VERIFICATION=true
OTP_EXPIRES_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_BYPASS_CODE=

# ── Password Reset ──────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30
PASSWORD_RESET_URL_BASE=https://app.fitnerve.com/reset-password

# ── Bcrypt ──────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── CORS ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# ── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ── File Storage ────────────────────────────────────────
# STORAGE_DRIVER = "local" | "s3"
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ── AWS S3 (only used when STORAGE_DRIVER=s3) ──────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=fitnerve-media

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info

# ── Google Meet (platform-wide booking links) ────────────
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Must exactly match the Authorized redirect URI in Google Cloud Console.
GOOGLE_MEET_REDIRECT_URI=https://api-fitnerve.kwiko.org/api/v1/integrations/google-meet/callback

# ── Push Notifications (Phase 3 — Firebase Cloud Messaging) ──
# Base64-encode your Firebase service account JSON:
#   base64 -i serviceAccountKey.json | tr -d '\n'
# Leave empty to run with push sends disabled (in-app notifications still work).
FCM_SERVICE_ACCOUNT_BASE64=

# ── Reminder cron sweep (Phase 3) ──────────────────────────
ENABLE_CRON=true
REMINDER_SWEEP_CRON="*/15 * * * *"

# ── AI Coach chat assist (Gemini) — optional, falls back to a canned reply ──
GEMINI_API_KEY=
