// FitNerve Backend — Phase 1 Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────────────────

enum Role {
  USER
  COACH
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Goal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
  REHAB
}

enum MediaType {
  PROFILE_IMAGE
  PROGRESS_IMAGE
  COACH_IMAGE
  CHAT_IMAGE
  CONTENT_IMAGE
}

enum PhotoAngle {
  FRONT
  BACK
  LEFT
  RIGHT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ────────────────────────────────────────────────────────────
// PHASE 2 ENUMS
// ────────────────────────────────────────────────────────────

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum WorkoutCategoryKey {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  CARDIO
  YOGA
  GENERAL_FITNESS
}

enum WorkoutDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ActivityType {
  WORKOUT_COMPLETED
  MEAL_LOGGED
  HYDRATION_GOAL
  APPOINTMENT_BOOKED
  STEP_MILESTONE
  BMI_LOGGED
  WEIGHT_LOGGED
  OTHER
}

enum NotificationType {
  WORKOUT_REMINDER
  APPOINTMENT_REMINDER
  COACH_MESSAGE
  ANNOUNCEMENT
  SYSTEM
}

enum DevicePlatform {
  IOS
  ANDROID
}

// ────────────────────────────────────────────────────────────
// CORE IDENTITY
// ────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  role            Role      @default(USER)
  isActive        Boolean   @default(true) @map("is_active")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profile       UserProfile?
  coach         Coach?
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  media         Media[]

  bmiLogs                BmiLog[]
  calorieLogs            CalorieLog[]
  stepLogs               StepLog[]
  activityLogs           ActivityLog[]
  weightLogs             WeightLog[]
  bodyMeasurements       BodyMeasurement[]
  workoutCompletions     WorkoutCompletion[]
  scheduledWorkouts      ScheduledWorkout[]
  appointments           Appointment[]
  notifications          Notification[]
  deviceTokens           DeviceToken[]
  adminAuditLogs         AdminAuditLog[]
  chatRoomsAsUser        ChatRoom[]              @relation("ChatRoomsAsUser")
  chatMessagesSent       ChatMessage[]           @relation("ChatMessagesSent")
  notificationPreference NotificationPreference?
  contentPosts           ContentPost[]
  customWorkouts         CustomWorkout[]
  payments               Payment[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id              String   @id @default(uuid())
  token           String   @unique
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime @map("expires_at")
  revoked         Boolean  @default(false)
  replacedByToken String?  @map("replaced_by_token")
  createdByIp     String?  @map("created_by_ip")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

model OtpCode {
  id        String     @id @default(uuid())
  codeHash  String     @map("code_hash")
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  used      Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@map("otp_codes")
}

// ────────────────────────────────────────────────────────────
// USER MODULE (Phase 1)
// ────────────────────────────────────────────────────────────

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm        Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg        Decimal? @map("weight_kg") @db.Decimal(5, 2)
  age             Int?
  gender          Gender?
  goal            Goal?
  profileImageUrl String?  @map("profile_image_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// ────────────────────────────────────────────────────────────
// COACH MODULE (Phase 1 — base CRUD + availability basics)
// ────────────────────────────────────────────────────────────

model Coach {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  specialties        String[] @default([])
  experienceYears    Int?     @map("experience_years")
  profileImageUrl    String?  @map("profile_image_url")
  isAcceptingClients Boolean  @default(true) @map("is_accepting_clients")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  availability CoachAvailability[]
  appointments Appointment[]
  chatRooms    ChatRoom[]

  @@index([experienceYears])
  @@map("coaches")
}

model CoachAvailability {
  id        String    @id @default(uuid())
  coachId   String    @map("coach_id")
  coach     Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek @map("day_of_week")
  startTime String    @map("start_time") // "HH:mm" 24h
  endTime   String    @map("end_time") // "HH:mm" 24h
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([coachId, dayOfWeek, startTime])
  @@index([coachId])
  @@map("coach_availability")
}

// ────────────────────────────────────────────────────────────
// IMAGE UPLOAD MODULE (Phase 1 — generic media table)
// ────────────────────────────────────────────────────────────

model Media {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       MediaType
  url        String
  storageKey String      @map("storage_key") // S3 key or local relative path
  mimeType   String?     @map("mime_type")
  sizeBytes  Int?        @map("size_bytes")
  angle      PhotoAngle? // set only for PROGRESS_IMAGE uploads
  sessionId  String?     @map("session_id") // groups a set of PROGRESS_IMAGE uploads taken together
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([userId, type])
  @@index([userId, type, sessionId])
  @@map("media")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — BMI MODULE
// ────────────────────────────────────────────────────────────

model BmiLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm  Decimal  @map("height_cm") @db.Decimal(5, 2)
  weightKg  Decimal  @map("weight_kg") @db.Decimal(5, 2)
  bmi       Decimal  @db.Decimal(4, 1)
  category  String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("bmi_logs")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — CALORIE MODULE
// ────────────────────────────────────────────────────────────

model CalorieLog {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  age            Int
  gender         Gender
  heightCm       Decimal       @map("height_cm") @db.Decimal(5, 2)
  weightKg       Decimal       @map("weight_kg") @db.Decimal(5, 2)
  activityLevel  ActivityLevel @map("activity_level")
  goal           Goal
  bmr            Decimal       @db.Decimal(6, 1)
  tdee           Decimal       @db.Decimal(6, 1)
  targetCalories Decimal       @map("target_calories") @db.Decimal(6, 1)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("calorie_logs")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — ACTIVITY / STEPS MODULE
// ────────────────────────────────────────────────────────────

model StepLog {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  steps          Int
  distanceKm     Decimal? @map("distance_km") @db.Decimal(6, 2)
  caloriesBurned Int?     @map("calories_burned")
  activeMinutes  Int?     @map("active_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("step_logs")
}

model ActivityLog {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType
  description String
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — PROGRESS TRACKER MODULE
// ────────────────────────────────────────────────────────────

model WeightLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg Decimal  @map("weight_kg") @db.Decimal(5, 2)
  loggedAt DateTime @default(now()) @map("logged_at")

  @@index([userId, loggedAt])
  @@map("weight_logs")
}

model BodyMeasurement {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chestCm  Decimal? @map("chest_cm") @db.Decimal(5, 2)
  waistCm  Decimal? @map("waist_cm") @db.Decimal(5, 2)
  hipCm    Decimal? @map("hip_cm") @db.Decimal(5, 2)
  armCm    Decimal? @map("arm_cm") @db.Decimal(5, 2)
  thighCm  Decimal? @map("thigh_cm") @db.Decimal(5, 2)
  loggedAt DateTime @default(now()) @map("logged_at")

  @@index([userId, loggedAt])
  @@map("body_measurements")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — WORKOUT MODULE
// ────────────────────────────────────────────────────────────

model Exercise {
  id          String   @id @default(uuid())
  name        String
  description String?
  muscleGroup String?  @map("muscle_group")
  equipment   String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  planLinks WorkoutPlanExercise[]

  @@map("exercises")
}

model WorkoutPlan {
  id              String             @id @default(uuid())
  categoryKey     WorkoutCategoryKey @map("category_key")
  title           String
  description     String?
  durationMinutes Int                @map("duration_minutes")
  difficulty      WorkoutDifficulty
  accentColor     String             @map("accent_color")
  imageUrl        String?            @map("image_url")
  videoUrl        String?            @map("video_url")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  exercises   WorkoutPlanExercise[]
  completions WorkoutCompletion[]
  schedules   ScheduledWorkout[]

  @@index([categoryKey])
  @@index([isActive, categoryKey, difficulty])
  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id         String      @id @default(uuid())
  planId     String      @map("plan_id")
  plan       WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exerciseId String      @map("exercise_id")
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sortOrder  Int         @default(0) @map("sort_order")
  sets       Int?
  reps       Int?

  @@unique([planId, exerciseId])
  @@index([planId])
  @@map("workout_plan_exercises")
}

model WorkoutCompletion {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String      @map("plan_id")
  plan        WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  completedAt DateTime    @default(now()) @map("completed_at")

  @@index([userId, completedAt])
  @@map("workout_completions")
}

enum ScheduledWorkoutStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
}

// A user's plan to do a specific WorkoutPlan at a specific future time —
// distinct from WorkoutCompletion (a historical record of one already done).
// This is what powers the Calendar's "workout schedule" alongside appointments.
model ScheduledWorkout {
  id             String                 @id @default(uuid())
  userId         String                 @map("user_id")
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String                 @map("plan_id")
  plan           WorkoutPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime               @map("scheduled_at")
  status         ScheduledWorkoutStatus @default(SCHEDULED)
  reminderSentAt DateTime?              @map("reminder_sent_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([userId, scheduledAt])
  @@map("scheduled_workouts")
}

// ────────────────────────────────────────────────────────────
// USER-AUTHORED CUSTOM WORKOUTS (distinct from the admin-curated
// WorkoutPlan catalog above — never shared, never cached, always
// scoped to the owning user).
// ────────────────────────────────────────────────────────────

model CustomWorkout {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  durationMinutes Int?                @map("duration_minutes")
  difficulty      WorkoutDifficulty?
  categoryKey     WorkoutCategoryKey? @map("category_key")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  exercises CustomWorkoutExercise[]

  @@index([userId])
  @@map("custom_workouts")
}

model CustomWorkoutExercise {
  id              String        @id @default(uuid())
  customWorkoutId String        @map("custom_workout_id")
  customWorkout   CustomWorkout @relation(fields: [customWorkoutId], references: [id], onDelete: Cascade)
  name            String
  muscleGroup     String?       @map("muscle_group")
  equipment       String?
  sets            Int?
  reps            Int?
  sortOrder       Int           @default(0) @map("sort_order")

  @@index([customWorkoutId])
  @@map("custom_workout_exercises")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — APPOINTMENT MODULE
// ────────────────────────────────────────────────────────────

model Appointment {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId         String            @map("coach_id")
  coach           Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  title           String
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(45) @map("duration_minutes")
  status          AppointmentStatus @default(PENDING)
  notes           String?
  reminderSentAt  DateTime?         @map("reminder_sent_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([coachId, scheduledAt])
  @@index([userId, scheduledAt])
  @@map("appointments")
}

// ────────────────────────────────────────────────────────────
// PHASE 3 — PAYMENTS
// ────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  CASH
}

enum PaymentPurpose {
  COACH_SESSION
  SUBSCRIPTION
  CUSTOM_WORKOUT_PLAN
  OTHER
}

model Payment {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(10, 2)
  currency      String         @default("INR")
  status        PaymentStatus  @default(PENDING)
  method        PaymentMethod?
  purpose       PaymentPurpose @default(OTHER)
  referenceId   String?        @map("reference_id") // e.g. related appointmentId
  transactionId String?        @unique @map("transaction_id")
  paidAt        DateTime?      @map("paid_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("payments")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — NOTIFICATION GROUNDWORK
// ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_tokens")
}

// ────────────────────────────────────────────────────────────
// ADMIN PORTAL — AUDIT LOGGING
// ────────────────────────────────────────────────────────────

enum AdminAction {
  SUSPEND_USER
  ACTIVATE_USER
  CHANGE_ROLE
  RESET_PASSWORD
  DELETE_USER
  UPDATE_USER
  CREATE_COACH
  UPDATE_COACH
  DELETE_COACH
}

model AdminAuditLog {
  id         String      @id @default(uuid())
  adminId    String      @map("admin_id")
  admin      User        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     AdminAction
  targetType String      @map("target_type") // "USER" | "COACH"
  targetId   String      @map("target_id")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ────────────────────────────────────────────────────────────
// PHASE 3 — REAL-TIME CHAT (user ↔ coach)
// ────────────────────────────────────────────────────────────

enum MessageStatus {
  SENT
  DELIVERED
  SEEN
}

enum MessageType {
  TEXT
  IMAGE
}

// One room per (user, coach) pair. Created lazily on first message
// or when a user opens a coach's chat for the first time.
model ChatRoom {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation("ChatRoomsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  coachId        String    @map("coach_id")
  coach          Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  lastMessageAt  DateTime? @map("last_message_at")
  // "Clear chat" is per-viewer, not destructive: each side can hide the
  // history on their end (like WhatsApp) without deleting it for the other
  // participant. Messages created at/before this timestamp are hidden from
  // that side's message list.
  userClearedAt  DateTime? @map("user_cleared_at")
  coachClearedAt DateTime? @map("coach_cleared_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  messages ChatMessage[]

  @@unique([userId, coachId])
  @@index([userId, lastMessageAt])
  @@index([coachId, lastMessageAt])
  @@map("chat_rooms")
}

model ChatMessage {
  id          String        @id @default(uuid())
  roomId      String        @map("room_id")
  room        ChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String        @map("sender_id")
  sender      User          @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  type        MessageType   @default(TEXT)
  body        String?
  imageUrl    String?       @map("image_url")
  status      MessageStatus @default(SENT)
  deliveredAt DateTime?     @map("delivered_at")
  seenAt      DateTime?     @map("seen_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// ────────────────────────────────────────────────────────────
// PHASE 3 — NOTIFICATION PREFERENCES
// ────────────────────────────────────────────────────────────

model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutReminders     Boolean  @default(true) @map("workout_reminders")
  appointmentReminders Boolean  @default(true) @map("appointment_reminders")
  coachMessages        Boolean  @default(true) @map("coach_messages")
  announcements        Boolean  @default(true) @map("announcements")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

// ────────────────────────────────────────────────────────────
// PHASE 3 — CONTENT MANAGEMENT SYSTEM
// ────────────────────────────────────────────────────────────

enum ContentType {
  BLOG
  VIDEO
  WORKOUT_TIP
  NUTRITION_TIP
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  posts ContentPost[]

  @@map("content_categories")
}

model ContentPost {
  id            String           @id @default(uuid())
  type          ContentType
  title         String
  slug          String           @unique
  summary       String?
  body          String?
  videoUrl      String?          @map("video_url")
  coverImageUrl String?          @map("cover_image_url")
  status        ContentStatus    @default(DRAFT)
  categoryId    String?          @map("category_id")
  category      ContentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId      String           @map("author_id")
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  viewCount     Int              @default(0) @map("view_count")
  publishedAt   DateTime?        @map("published_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([type, status, publishedAt])
  @@index([categoryId])
  @@map("content_posts")
}
