// FitNerve Backend — Phase 1 Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────────────────

enum Role {
  USER
  COACH
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Goal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
  REHAB
}

enum MediaType {
  PROFILE_IMAGE
  PROGRESS_IMAGE
  COACH_IMAGE
  CHAT_IMAGE
  CONTENT_IMAGE
}

enum PhotoAngle {
  FRONT
  BACK
  LEFT
  RIGHT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ────────────────────────────────────────────────────────────
// PHASE 2 ENUMS
// ────────────────────────────────────────────────────────────

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum WorkoutCategoryKey {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  CARDIO
  YOGA
  GENERAL_FITNESS
}

enum WorkoutDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MeetingProvider {
  MANUAL
  GOOGLE_MEET
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ActivityType {
  WORKOUT_COMPLETED
  MEAL_LOGGED
  HYDRATION_GOAL
  APPOINTMENT_BOOKED
  STEP_MILESTONE
  BMI_LOGGED
  WEIGHT_LOGGED
  OTHER
}

enum NotificationType {
  WORKOUT_REMINDER
  WORKOUT_ASSIGNED
  APPOINTMENT_REMINDER
  APPOINTMENT_CHANGED
  COACH_MESSAGE
  ANNOUNCEMENT
  SYSTEM
}

enum DevicePlatform {
  IOS
  ANDROID
}

// ────────────────────────────────────────────────────────────
// CORE IDENTITY
// ────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  phone           String?   @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  role            Role      @default(USER)
  isActive        Boolean   @default(true) @map("is_active")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // The one coach this user is assigned to (admin-managed). A coach can have
  // many assigned users; a user has at most one coach. Nulled automatically
  // if the coach profile is deleted.
  assignedCoachId String? @map("assigned_coach_id")
  assignedCoach   Coach?  @relation("CoachClients", fields: [assignedCoachId], references: [id], onDelete: SetNull)

  profile       UserProfile?
  coach         Coach?
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  media         Media[]

  bmiLogs                  BmiLog[]
  calorieLogs              CalorieLog[]
  stepLogs                 StepLog[]
  activityLogs             ActivityLog[]
  weightLogs               WeightLog[]
  bodyMeasurements         BodyMeasurement[]
  workoutCompletions       WorkoutCompletion[]
  scheduledWorkouts        ScheduledWorkout[]
  appointments             Appointment[]
  notifications            Notification[]
  deviceTokens             DeviceToken[]
  adminAuditLogs           AdminAuditLog[]
  chatRoomsAsUser          ChatRoom[]                @relation("ChatRoomsAsUser")
  chatMessagesSent         ChatMessage[]             @relation("ChatMessagesSent")
  notificationPreference   NotificationPreference?
  contentPosts             ContentPost[]
  customWorkouts           CustomWorkout[]
  assignedCustomWorkouts   CustomWorkout[]           @relation("UserAssignedCustomWorkouts")
  createdCustomWorkouts    CustomWorkout[]           @relation("UserCreatedCustomWorkouts")
  assignedWorkoutPlans     AssignedWorkoutPlan[]     @relation("AssignedWorkoutPlanRecipient")
  workoutPlansAssigned     AssignedWorkoutPlan[]     @relation("AssignedWorkoutPlanAssigner")
  workoutPlansCreated      AssignedWorkoutPlan[]     @relation("AssignedWorkoutPlanCreator")
  payments                 Payment[]
  googleCalendarConnection GoogleCalendarConnection?
  favoriteCoaches          FavoriteCoach[]
  supportTickets           SupportTicket[]
  coachReports             CoachReport[]

  @@index([role])
  @@index([assignedCoachId])
  @@map("users")
}

model GoogleCalendarConnection {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  googleAccountId String?   @map("google_account_id")
  accessToken     String?   @map("access_token")
  refreshToken    String?   @map("refresh_token")
  expiresAt       DateTime? @map("expires_at")
  scope           String?
  tokenType       String?   @map("token_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("google_calendar_connections")
}

model RefreshToken {
  id              String   @id @default(uuid())
  token           String   @unique
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime @map("expires_at")
  revoked         Boolean  @default(false)
  replacedByToken String?  @map("replaced_by_token")
  createdByIp     String?  @map("created_by_ip")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

model OtpCode {
  id        String     @id @default(uuid())
  codeHash  String     @map("code_hash")
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  used      Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@map("otp_codes")
}

// ────────────────────────────────────────────────────────────
// USER MODULE (Phase 1)
// ────────────────────────────────────────────────────────────

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm        Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg        Decimal? @map("weight_kg") @db.Decimal(5, 2)
  age             Int?
  gender          Gender?
  goal            Goal?
  fitnessGoals    String[] @default([]) @map("fitness_goals")
  profileImageUrl String?  @map("profile_image_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// ────────────────────────────────────────────────────────────
// COACH MODULE (Phase 1 — base CRUD + availability basics)
// ────────────────────────────────────────────────────────────

model Coach {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  specialties        String[] @default([])
  experienceYears    Int?     @map("experience_years")
  profileImageUrl    String?  @map("profile_image_url")
  isAcceptingClients Boolean  @default(true) @map("is_accepting_clients")
  // The head coach oversees every coach: the coach portal shows them all clients,
  // sessions and records instead of only their own. Set by an admin.
  isHeadCoach        Boolean  @default(false) @map("is_head_coach")
  // Optional note the coach wants every client to receive in Chats right after they book a session.
  bookingMessage     String?  @map("booking_message")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  availability CoachAvailability[]
  appointments Appointment[]
  chatRooms    ChatRoom[]
  clients      User[]              @relation("CoachClients")
  favoritedBy  FavoriteCoach[]
  reports      CoachReport[]

  @@index([experienceYears])
  @@map("coaches")
}

model CoachAvailability {
  id        String    @id @default(uuid())
  coachId   String    @map("coach_id")
  coach     Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek @map("day_of_week")
  startTime String    @map("start_time") // "HH:mm" 24h
  endTime   String    @map("end_time") // "HH:mm" 24h
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([coachId, dayOfWeek, startTime])
  @@index([coachId])
  @@map("coach_availability")
}

// ────────────────────────────────────────────────────────────
// IMAGE UPLOAD MODULE (Phase 1 — generic media table)
// ────────────────────────────────────────────────────────────

model Media {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       MediaType
  url        String
  storageKey String      @map("storage_key") // S3 key or local relative path
  mimeType   String?     @map("mime_type")
  sizeBytes  Int?        @map("size_bytes")
  angle      PhotoAngle? // set only for PROGRESS_IMAGE uploads
  sessionId  String?     @map("session_id") // groups a set of PROGRESS_IMAGE uploads taken together
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([userId, type])
  @@index([userId, type, sessionId])
  @@map("media")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — BMI MODULE
// ────────────────────────────────────────────────────────────

model BmiLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm  Decimal  @map("height_cm") @db.Decimal(5, 2)
  weightKg  Decimal  @map("weight_kg") @db.Decimal(5, 2)
  bmi       Decimal  @db.Decimal(4, 1)
  category  String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("bmi_logs")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — CALORIE MODULE
// ────────────────────────────────────────────────────────────

model CalorieLog {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  age            Int
  gender         Gender
  heightCm       Decimal       @map("height_cm") @db.Decimal(5, 2)
  weightKg       Decimal       @map("weight_kg") @db.Decimal(5, 2)
  activityLevel  ActivityLevel @map("activity_level")
  goal           Goal
  bmr            Decimal       @db.Decimal(6, 1)
  tdee           Decimal       @db.Decimal(6, 1)
  targetCalories Decimal       @map("target_calories") @db.Decimal(6, 1)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("calorie_logs")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — ACTIVITY / STEPS MODULE
// ────────────────────────────────────────────────────────────

model StepLog {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  steps          Int
  distanceKm     Decimal? @map("distance_km") @db.Decimal(6, 2)
  caloriesBurned Int?     @map("calories_burned")
  activeMinutes  Int?     @map("active_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("step_logs")
}

model ActivityLog {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType
  description String
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — PROGRESS TRACKER MODULE
// ────────────────────────────────────────────────────────────

model WeightLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg Decimal  @map("weight_kg") @db.Decimal(5, 2)
  loggedAt DateTime @default(now()) @map("logged_at")

  @@index([userId, loggedAt])
  @@map("weight_logs")
}

model BodyMeasurement {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chestCm  Decimal? @map("chest_cm") @db.Decimal(5, 2)
  waistCm  Decimal? @map("waist_cm") @db.Decimal(5, 2)
  hipCm    Decimal? @map("hip_cm") @db.Decimal(5, 2)
  armCm    Decimal? @map("arm_cm") @db.Decimal(5, 2)
  thighCm  Decimal? @map("thigh_cm") @db.Decimal(5, 2)
  loggedAt DateTime @default(now()) @map("logged_at")

  @@index([userId, loggedAt])
  @@map("body_measurements")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — WORKOUT MODULE
// ────────────────────────────────────────────────────────────

model Exercise {
  id          String   @id @default(uuid())
  name        String
  description String?
  muscleGroup String?  @map("muscle_group")
  equipment   String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  planLinks WorkoutPlanExercise[]

  @@map("exercises")
}

model WorkoutPlan {
  id              String             @id @default(uuid())
  categoryKey     WorkoutCategoryKey @map("category_key")
  title           String
  description     String?
  durationMinutes Int                @map("duration_minutes")
  difficulty      WorkoutDifficulty
  accentColor     String             @map("accent_color")
  imageUrl        String?            @map("image_url")
  videoUrl        String?            @map("video_url")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  exercises   WorkoutPlanExercise[]
  completions WorkoutCompletion[]
  schedules   ScheduledWorkout[]
  assignments AssignedWorkoutPlan[]

  @@index([categoryKey])
  @@index([isActive, categoryKey, difficulty])
  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id         String      @id @default(uuid())
  planId     String      @map("plan_id")
  plan       WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exerciseId String      @map("exercise_id")
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sortOrder  Int         @default(0) @map("sort_order")
  sets       Int?
  reps       Int?

  @@unique([planId, exerciseId])
  @@index([planId])
  @@map("workout_plan_exercises")
}

model WorkoutCompletion {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String      @map("plan_id")
  plan        WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  completedAt DateTime    @default(now()) @map("completed_at")

  @@index([userId, completedAt])
  @@map("workout_completions")
}

enum ScheduledWorkoutStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
}

// A user's plan to do a specific WorkoutPlan at a specific future time —
// distinct from WorkoutCompletion (a historical record of one already done).
// This is what powers the Calendar's "workout schedule" alongside appointments.
model ScheduledWorkout {
  id             String                 @id @default(uuid())
  userId         String                 @map("user_id")
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String                 @map("plan_id")
  plan           WorkoutPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime               @map("scheduled_at")
  status         ScheduledWorkoutStatus @default(SCHEDULED)
  reminderSentAt DateTime?              @map("reminder_sent_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([userId, scheduledAt])
  @@map("scheduled_workouts")
}

// ────────────────────────────────────────────────────────────
// USER-AUTHORED CUSTOM WORKOUTS (distinct from the admin-curated
// WorkoutPlan catalog above — never shared, never cached, always
// scoped to the owning user).
// ────────────────────────────────────────────────────────────

model CustomWorkout {
  id               String              @id @default(uuid())
  userId           String              @map("user_id")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  durationMinutes  Int?                @map("duration_minutes")
  difficulty       WorkoutDifficulty?
  categoryKey      WorkoutCategoryKey? @map("category_key")
  // Set when another user builds this workout for the owner (userId) —
  // null for workouts users author for themselves. When an admin sends this
  // "as" a coach, this holds the coach's id (for attribution to the owner),
  // while createdByUserId holds the admin's own id (who actually sent it).
  assignedByUserId String?             @map("assigned_by_user_id")
  assignedByUser   User?               @relation("UserAssignedCustomWorkouts", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  createdByUserId  String?             @map("created_by_user_id")
  createdByUser    User?               @relation("UserCreatedCustomWorkouts", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedAt      DateTime?            @map("completed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  exercises CustomWorkoutExercise[]

  @@index([userId])
  @@index([assignedByUserId])
  @@index([createdByUserId])
  @@map("custom_workouts")
}

model CustomWorkoutExercise {
  id              String        @id @default(uuid())
  customWorkoutId String        @map("custom_workout_id")
  customWorkout   CustomWorkout @relation(fields: [customWorkoutId], references: [id], onDelete: Cascade)
  name            String
  muscleGroup     String?       @map("muscle_group")
  equipment       String?
  sets            Int?
  reps            Int?
  sortOrder       Int           @default(0) @map("sort_order")

  @@index([customWorkoutId])
  @@map("custom_workout_exercises")
}

// One user pushing an existing catalog WorkoutPlan to another user —
// distinct from ScheduledWorkout (a user's own plan to do a workout).
model AssignedWorkoutPlan {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  user             User        @relation("AssignedWorkoutPlanRecipient", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String      @map("assigned_by_user_id")
  assignedByUser   User        @relation("AssignedWorkoutPlanAssigner", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  // Who actually sent this — equals assignedByUserId, except when an admin
  // sends it "as" a coach, in which case assignedByUserId is the coach
  // (shown to the recipient) and this is the admin who really did it.
  createdByUserId  String?     @map("created_by_user_id")
  createdByUser    User?       @relation("AssignedWorkoutPlanCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  planId           String      @map("plan_id")
  plan             WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  note             String?
  scheduledAt      DateTime?   @map("scheduled_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([assignedByUserId])
  @@index([createdByUserId])
  @@map("assigned_workout_plans")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — APPOINTMENT MODULE
// ────────────────────────────────────────────────────────────

model Appointment {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId         String            @map("coach_id")
  coach           Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  title           String
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(45) @map("duration_minutes")
  status          AppointmentStatus @default(PENDING)
  notes           String?
  reminderSentAt  DateTime?         @map("reminder_sent_at")
  // Video-call link for the session. Either pasted by the coach/admin (MANUAL)
  // or generated through the platform's connected Google account (GOOGLE_MEET),
  // in which case meetingEventId is the Google Calendar event that owns it.
  meetingLink     String?           @map("meeting_link")
  meetingProvider MeetingProvider?  @map("meeting_provider")
  meetingEventId  String?           @map("meeting_event_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([coachId, scheduledAt])
  @@index([userId, scheduledAt])
  @@map("appointments")
}

// ────────────────────────────────────────────────────────────
// PHASE 3 — PAYMENTS
// ────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  CASH
}

enum PaymentPurpose {
  COACH_SESSION
  SUBSCRIPTION
  CUSTOM_WORKOUT_PLAN
  OTHER
}

model Payment {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(10, 2)
  currency      String         @default("INR")
  status        PaymentStatus  @default(PENDING)
  method        PaymentMethod?
  purpose       PaymentPurpose @default(OTHER)
  referenceId   String?        @map("reference_id") // e.g. related appointmentId
  transactionId String?        @unique @map("transaction_id")
  paidAt        DateTime?      @map("paid_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("payments")
}

// ────────────────────────────────────────────────────────────
// PHASE 2 — NOTIFICATION GROUNDWORK
// ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_tokens")
}

// ────────────────────────────────────────────────────────────
// ADMIN PORTAL — AUDIT LOGGING
// ────────────────────────────────────────────────────────────

enum AdminAction {
  SUSPEND_USER
  ACTIVATE_USER
  CHANGE_ROLE
  RESET_PASSWORD
  DELETE_USER
  UPDATE_USER
  CREATE_USER
  CREATE_COACH
  UPDATE_COACH
  DELETE_COACH
  ASSIGN_COACH
  CREATE_PACKAGE
  UPDATE_PACKAGE
  DELETE_PACKAGE
  UPDATE_SUPPORT_TICKET
  UPDATE_COACH_REPORT
  CONNECT_INTEGRATION
  DISCONNECT_INTEGRATION
}

model AdminAuditLog {
  id         String      @id @default(uuid())
  adminId    String      @map("admin_id")
  admin      User        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     AdminAction
  targetType String      @map("target_type") // "USER" | "COACH"
  targetId   String      @map("target_id")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ────────────────────────────────────────────────────────────
// PHASE 3 — REAL-TIME CHAT (user ↔ coach)
// ────────────────────────────────────────────────────────────

enum MessageStatus {
  SENT
  DELIVERED
  SEEN
}

enum MessageType {
  TEXT
  IMAGE
}

// One room per (user, coach) pair. Created lazily on first message
// or when a user opens a coach's chat for the first time.
model ChatRoom {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation("ChatRoomsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  coachId         String    @map("coach_id")
  coach           Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime? @map("last_message_at")
  // "Clear chat" is per-viewer, not destructive: each side can hide the
  // history on their end (like WhatsApp) without deleting it for the other
  // participant. Messages created at/before this timestamp are hidden from
  // that side's message list.
  userClearedAt   DateTime? @map("user_cleared_at")
  coachClearedAt  DateTime? @map("coach_cleared_at")
  // Set when the user is swapped away from this coach (reassigned/removed). The chat leaves the
  // user's list unless they are assigned to this coach again or book a session after this time.
  closedForUserAt DateTime? @map("closed_for_user_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  messages ChatMessage[]

  @@unique([userId, coachId])
  @@index([userId, lastMessageAt])
  @@index([coachId, lastMessageAt])
  @@map("chat_rooms")
}

model ChatMessage {
  id          String        @id @default(uuid())
  roomId      String        @map("room_id")
  room        ChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String        @map("sender_id")
  sender      User          @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  type        MessageType   @default(TEXT)
  body        String?
  imageUrl    String?       @map("image_url")
  status      MessageStatus @default(SENT)
  deliveredAt DateTime?     @map("delivered_at")
  seenAt      DateTime?     @map("seen_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// ────────────────────────────────────────────────────────────
// PHASE 3 — NOTIFICATION PREFERENCES
// ────────────────────────────────────────────────────────────

model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutReminders     Boolean  @default(true) @map("workout_reminders")
  appointmentReminders Boolean  @default(true) @map("appointment_reminders")
  coachMessages        Boolean  @default(true) @map("coach_messages")
  announcements        Boolean  @default(true) @map("announcements")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

// ────────────────────────────────────────────────────────────
// PHASE 3 — CONTENT MANAGEMENT SYSTEM
// ────────────────────────────────────────────────────────────

enum ContentType {
  BLOG
  VIDEO
  WORKOUT_TIP
  NUTRITION_TIP
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  posts ContentPost[]

  @@map("content_categories")
}

model ContentPost {
  id            String           @id @default(uuid())
  type          ContentType
  title         String
  slug          String           @unique
  summary       String?
  body          String?
  videoUrl      String?          @map("video_url")
  coverImageUrl String?          @map("cover_image_url")
  status        ContentStatus    @default(DRAFT)
  categoryId    String?          @map("category_id")
  category      ContentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId      String           @map("author_id")
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  viewCount     Int              @default(0) @map("view_count")
  publishedAt   DateTime?        @map("published_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([type, status, publishedAt])
  @@index([categoryId])
  @@map("content_posts")
}

// ────────────────────────────────────────────────────────────
// MEMBERSHIP PACKAGES (duration plans shown on the Packages screen)
// ────────────────────────────────────────────────────────────

model Package {
  id             String   @id @default(uuid())
  name           String
  tagline        String?
  durationMonths Int      @map("duration_months")
  price          Decimal  @db.Decimal(10, 2) // total price for the whole duration
  originalPrice  Decimal  @map("original_price") @db.Decimal(10, 2) // struck-through MRP
  currency       String   @default("INR")
  features       String[]
  badge          String? // e.g. "BEST VALUE"
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("packages")
}

// ────────────────────────────────────────────────────────────
// FAVOURITE COACHES, COACH REPORTS, SUPPORT TICKETS
// ────────────────────────────────────────────────────────────

model FavoriteCoach {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId   String   @map("coach_id")
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, coachId])
  @@index([coachId])
  @@map("favorite_coaches")
}

enum CoachReportReason {
  UNRESPONSIVE
  MISSED_SESSIONS
  UNPROFESSIONAL
  NOT_A_GOOD_FIT
  INAPPROPRIATE_BEHAVIOUR
  OTHER
}

enum CoachReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

// A user's complaint about a coach. Admins review it and may move the user to
// another coach (reassignedToCoachId records which one).
model CoachReport {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId             String            @map("coach_id")
  coach               Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  reason              CoachReportReason
  details             String?
  wantsNewCoach       Boolean           @default(false) @map("wants_new_coach")
  status              CoachReportStatus @default(OPEN)
  adminNote           String?           @map("admin_note")
  reassignedToCoachId String?           @map("reassigned_to_coach_id")
  resolvedAt          DateTime?         @map("resolved_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([coachId])
  @@index([userId])
  @@map("coach_reports")
}

enum SupportTicketCategory {
  GENERAL
  ACCOUNT
  PAYMENT
  TECHNICAL
  COACH
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    SupportTicketCategory @default(GENERAL)
  subject     String
  message     String
  status      SupportTicketStatus   @default(OPEN)
  adminReply  String?               @map("admin_reply")
  repliedById String?               @map("replied_by_id") // admin who last replied
  repliedAt   DateTime?             @map("replied_at")
  resolvedAt  DateTime?             @map("resolved_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("support_tickets")
}

// ────────────────────────────────────────────────────────────
// PLATFORM-LEVEL INTEGRATIONS (one row per provider)
// ────────────────────────────────────────────────────────────

// The single Google account the platform uses to create a unique Google Meet
// link for every session. Tokens are AES-256-GCM encrypted (googleTokenCrypto).
model PlatformIntegration {
  id            String    @id @default(uuid())
  provider      String    @unique // "GOOGLE_MEET"
  accountEmail  String?   @map("account_email")
  accessToken   String?   @map("access_token")
  refreshToken  String?   @map("refresh_token")
  expiresAt     DateTime? @map("expires_at")
  scope         String?
  connectedById String?   @map("connected_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("platform_integrations")
}
